# Optional overlay inputs. Values ending in _SOURCE are host secret-file paths,
# not secret payloads. Files MUST be owned by UID/GID 10001 and mode 0400.
#
# Group A (all or none) enables the Rust+ supervisor and, with LOGIN_PUBLIC_HOST,
# the Discord /login command.
RUSTPLUS_FCM_SENDER_ID_SOURCE=/run/secrets/xiao-rustplus-fcm-sender-id
SECRET_KEYRING_SOURCE=/run/secrets/xiao-rustplus-secret-keyring
# Non-secret key metadata.
SECRET_ACTIVE_KEY_ID=key-2026-v1

# Group B (legacy operator-supplied account; both or neither; requires group A).
# An account enrolled through /login takes precedence after an explicit
# replacement; remove group B once /login is in use.
RUSTPLUS_STEAM_AUTH_TOKEN_SOURCE=/run/secrets/xiao-rustplus-steam-auth-token
RUSTPLUS_STEAM_ID=76561198000000000

# Optional public host of the xiao-login service: host name only, lowercase,
# no scheme, port, or path. /login is enabled only when group A and this are set.
# LOGIN_PUBLIC_HOST=login.example.com
