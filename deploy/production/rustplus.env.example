# Optional overlay inputs. Values ending in _SOURCE are host secret-file paths,
# not secret payloads. Files MUST be owned by UID/GID 10001 and mode 0400.
RUSTPLUS_FCM_SENDER_ID_SOURCE=/run/secrets/xiao-rustplus-fcm-sender-id
RUSTPLUS_STEAM_AUTH_TOKEN_SOURCE=/run/secrets/xiao-rustplus-steam-auth-token
SECRET_KEYRING_SOURCE=/run/secrets/xiao-rustplus-secret-keyring
# Non-secret account/key metadata.
RUSTPLUS_STEAM_ID=76561198000000000
SECRET_ACTIVE_KEY_ID=key-2026-v1
