# Copy to an untracked secret file or inject from the platform secret manager.
# Never commit real values. XIAO_IMAGE must include an immutable digest.
XIAO_IMAGE=registry.example.invalid/xiao/bot:0.2.0@sha256:REPLACE_WITH_RELEASE_DIGEST
DISCORD_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
DATABASE_URL=postgres://USER:PASSWORD@postgres.example.invalid:5432/xiao?sslmode=verify-full
# Optional Rust+/FCM integration; leave empty to disable it until #16 credential persistence lands.
RUSTPLUS_FCM_SENDER_ID=
RUST_LOG=info
TELEMETRY_FORMAT=json
