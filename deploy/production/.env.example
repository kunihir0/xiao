# Copy to an untracked deployment environment file. Values are host paths to
# secret-manager-mounted files, not credential payloads.
# XIAO_IMAGE MUST include an immutable @sha256:<64-hex> manifest digest.
XIAO_IMAGE=registry.example.invalid/xiao/bot:0.2.0@sha256:REPLACE_WITH_RELEASE_DIGEST
DISCORD_TOKEN_FILE=/run/secrets/xiao-discord-token
# Runtime least-privilege DML connection URL.
DATABASE_URL_FILE=/run/secrets/xiao-database-url
# Dedicated migration DDL connection URL used by the migration one-shot job.
MIGRATION_DATABASE_URL_FILE=/run/secrets/xiao-migration-database-url
# CA certificate bundle file required for production verify-full TLS.
DATABASE_CA_FILE=/run/secrets/xiao-database-ca.crt
# Production runtime runs with startup migrations disabled (schema verified at startup).
DATABASE_MIGRATE_ON_STARTUP=false
# Optional; omit to disable Rust+/FCM until #16 credential persistence lands.
RUSTPLUS_FCM_SENDER_ID_FILE=/run/secrets/xiao-rustplus-fcm-sender-id
RUST_LOG=info
TELEMETRY_FORMAT=json
