{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo nextest *)",
      "Bash(cargo build *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny *)",
      "Bash(cargo shear)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git fetch *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(//run/secrets/**)",
      "Edit(./.omp/**)",
      "Write(./.omp/**)",
      "Edit(./.omp.bak/**)",
      "Write(./.omp.bak/**)"
    ]
  }
}
